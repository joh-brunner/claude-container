{
  "name": "safe-agent-workspace",
  "initializeCommand": [
    "bash",
    "${localWorkspaceFolder}/.devcontainer/initialize.sh",
    "${localWorkspaceFolder}"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "CLAUDE_CODE_VERSION": "latest",
      "TZ": "Europe/Berlin"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--memory=8g",
    "--pids-limit=4096",
    "--hostname=agent-container"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=agent-claude-config-${devcontainerId},target=/home/dev/.claude,type=volume",
    "source=agent-history-${devcontainerId},target=/commandhistory,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.vscode,target=/workspace/.vscode,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/hooks,target=/workspace/.git/hooks,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/config,target=/workspace/.git/config,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/modules,target=/workspace/.git/modules,type=bind,readonly"
  ],
  "remoteUser": "dev",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "ALLOW_HOST_NETWORK": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "telemetry.telemetryLevel": "off"
      }
    }
  },
  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && bash /workspace/.devcontainer/post-start.sh",
  "waitFor": "postStartCommand"
}
